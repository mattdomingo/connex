# Server
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Database
DB_PATH=./data/connex.db

# Auth
JWT_SECRET=change-me-in-production

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/integrations/google/connect/callback
GOOGLE_AUTH_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Google OAuth token encryption (32-byte hex key)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_OAUTH_ENCRYPTION_KEY=

# Gmail sync
GMAIL_BACKFILL_DAYS=180
GMAIL_BATCH_SIZE=100
